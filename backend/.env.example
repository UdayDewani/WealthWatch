# WealthWatch 2.0 — Backend Configuration Example
# Copy this file to .env and fill in your actual credentials

# Server
PORT=4040

# JWT Authentication
JWT_SECRET=wealthwatch-dev-secret-change-in-prod
JWT_EXPIRE_HOURS=24

# AI Models (Gemini / OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Upstox API
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_SECRET_KEY=your_upstox_secret_key_here

# Email Delivery (Gmail SMTP)
GMAIL_SENDER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# Intervals
SNAPSHOT_INTERVAL_HOURS=1
ANALYSIS_INTERVAL=60
